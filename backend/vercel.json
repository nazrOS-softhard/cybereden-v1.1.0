
{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "dist/server.js",
      "use": "@vercel/node",
      "config": {"maxDuration": 60}
    }
  ],
  "routes": [{"src": "/(.*)", "dest": "dist/server.js"}]
}
