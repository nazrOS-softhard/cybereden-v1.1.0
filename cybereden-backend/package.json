{
  "name": "cybereden-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for CyberEden",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:create": "wrangler d1 create cybereden-db",
    "db:migrate": "wrangler d1 execute cybereden-db --file src/db/schema.sql",
    "db:seed": "wrangler d1 execute cybereden-db --file src/db/seed.sql",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "cybereden",
    "oauth2"
  ],
  "author": "CyberEden Team",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240425.0",
    "itty-router": "^4.1.3",
    "jsonwebtoken": "^9.1.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "wrangler": "^3.26.0"
  }
}

